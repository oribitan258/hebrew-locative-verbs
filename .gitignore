.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# Model caches (if ever placed in-repo)
/.hf_cache/

# OS / editor
Thumbs.db
desktop.ini
